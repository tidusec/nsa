# Environment variables for NSA application
# Copy this to .env and set your own secure values

# Database configuration
POSTGRES_USER=dbuser
POSTGRES_DB=vulndb
# Generate a secure password: openssl rand -base64 32
POSTGRES_PASSWORD=your_secure_database_password_here

# Application configuration  
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=your_secure_flask_secret_key_here

# Security settings
FLASK_DEBUG=false

# Admin escalation (leave empty to disable test endpoint privilege escalation)
NSA_ADMIN_ESCALATION_KEY=

# Example secure values (replace with your own):
# POSTGRES_PASSWORD=K7x9M2nP4wQ8vR5tY6uE3rT1zX0cV9bN
# FLASK_SECRET_KEY=A1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q7R8S9T0U1V2W3X4Y5Z6